# frozen_string_literal: true

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
                                                 'require.resolve(
                                                   "react-native/scripts/react_native_pods.rb",
                                                   {paths: [process.argv[1]]},
                                                 )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
unless linkage.nil?
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! linkage: linkage.to_sym
end

# react-native-firebase v26 resuelve el SDK de Firebase por Swift Package
# Manager, y sus productos son librerías automáticas: con el enlazado estático
# que usa React Native 0.82 cada pod acaba embebiendo su propia copia y el
# enlazador se queja de símbolos duplicados. Volviendo a los pods clásicos de
# Firebase (que sí saben convivir en estático) se resuelve, y no perdemos nada:
# es la ruta que react-native-firebase ha usado siempre.
$RNFirebaseDisableSPM = true

target 'Ahora' do
  config = use_native_modules!

  # Los pods de Firebase escritos en Swift necesitan importar estos, que son
  # Objective-C sin module map propio. En enlazado estático eso no compila a
  # menos que se les pida generar el module map. Es el arreglo que documenta
  # react-native-firebase; se listan uno a uno en vez de poner
  # `use_modular_headers!` global para no cambiarle las reglas al resto de
  # pods del proyecto.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  use_react_native!(
    path: config[:reactNativePath],
    # An absolute path to your application root.
    app_path: "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      mac_catalyst_enabled: false
      # :ccache_enabled => true
    )
  end
end
